<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization Header to PHP under FastCGI / PHP-FPM
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1. Forward all /api/* requests directly to PHP front controller
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]

    # 2. Redirect external requests with .html to clean URLs (301 Permanent Redirect)
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^ / [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 3. Allow direct access to physical files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Clean URLs for main pages
    RewriteRule ^login/?$ login.html [L]
    RewriteRule ^register/?$ register.html [L]
    RewriteRule ^forgot-password/?$ forgot-password.html [L]
    RewriteRule ^track-public/?$ track-public.html [L]
    RewriteRule ^track/?$ track-public.html [L]
    RewriteRule ^dashboard/?$ dashboard.html [L]
    RewriteRule ^admin/?$ admin.html [L]
    RewriteRule ^track/([^/]+)/?$ track-public.html?awb=$1 [QSA,L]

    # 4. Fallback for subroutes (e.g. /orders, /wallet, /addresses -> dashboard.html)
    RewriteRule ^(orders|wallet|addresses|rates|serviceability|ndr|cod|tickets|settings)(/.*)?$ dashboard.html [L]
    RewriteRule ^admin/(.*)$ admin.html [L]

    # 5. Default fallback to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# Security: Deny direct access to sensitive config files
<FilesMatch "^(db\.php|jwt\.php|\.env|.*\.sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>
